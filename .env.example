DATABASE_URL="postgresql://user:password@localhost:5432/myfitness"
BASE_URL="http://localhost:4200"
PORT=4200

# Garmin Connect
GARMIN_EMAIL=""
GARMIN_PASSWORD=""

# OMRON Connect 직접 연동 (#514) — 5개 모두 있어야 활성. 없으면 OMRON 싱크만 건너뛴다.
# APP_ID / APP_KEY / API_BASE 는 OMRON 앱 값 (아시아 리전 · 한국 계정) — 저장소에 커밋 금지
OMRON_EMAIL=""
OMRON_PASSWORD=""
OMRON_APP_ID=""
OMRON_APP_KEY=""
OMRON_API_BASE=""

# Cron
SYNC_CRON="0 6,9,12,15,18,21 * * *"
MORNING_REPORT_CRON="0 8 * * *"
EVENING_REPORT_CRON="0 23 * * *"
REPORT_CRON="0 7 * * 1"

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""

# Claude CLI 절대 경로 (운영 필수). 봇 프로세스가 pm2 delete + start로 시작되면
# login shell profile 미로드로 ~/.local/bin이 PATH에서 누락되어 spawn ENOENT.
# `which claude` 결과를 사용. 미설정/빈문자열이면 PATH 조회 (개발 환경 편의).
# 값 예시 (운영자가 실제 경로로 교체):
# CLAUDE_BIN=/home/user/.local/bin/claude

# #315 (M14 Phase 2 #4): 오픈식약처 식품영양성분DB — data.go.kr 통합 인증키.
# 활용신청: https://www.data.go.kr → "식품의약품안전처_식품영양성분DB정보" 검색 → 활용신청.
# 없으면 estimator 가 null 반환 → AI text estimator 로 자동 폴백 (기능 저하 없음).
MFDS_API_KEY=""
